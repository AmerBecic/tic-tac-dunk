generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id                       String   @id
  name                     String
  firstSeason              Int
  lastSeason               Int
  teams                    String[]
  highestFgPercentage      Float
  highestSeasonPointsTotal Int
  mvp                      Boolean
  dpoy                     Boolean
  roy                      Boolean
  mip                      Boolean
  as                       Boolean
}