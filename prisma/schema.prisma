generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                       String   @id
  name                     String
  firstSeason              Int      @map("first_season")
  lastSeason               Int      @map("last_season")
  teams                    String[]
  highestFgPercentage      Float    @map("highest_fg_percentage")
  highestSeasonPointsTotal Int      @map("highest_season_points_total")
  mvp                      Boolean
  dpoy                     Boolean
  roy                      Boolean
  mip                      Boolean
  as                       Boolean

  @@map("players")
}