generator client {
  provider = "prisma-client"
  output   = "../src/core/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DailyPuzzle {
  id         String   @id
  puzzleDate DateTime @unique @map("puzzle_date") @db.Date
  gridData   Json     @map("grid_data") @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("daily_puzzles")
}

model Team {
  code           String   @id
  name           String
  primaryColor   String   @map("primary_color")
  secondaryColor String   @map("secondary_color")
  includedNames  String[] @default([]) @map("included_names")

  @@map("teams")
}

model Player {
  id                       String   @id
  name                     String
  firstSeason              Int      @map("first_season")
  lastSeason               Int      @map("last_season")
  teams                    String[]
  mainTeam                 String?  @map("main_team")
  highestFgPercentage      Float    @map("highest_fg_percentage")
  highestSeasonPointsTotal Int      @map("highest_season_points_total")
  mvp                      Boolean
  dpoy                     Boolean
  roy                      Boolean
  mip                      Boolean
  as                       Boolean
  teammateClueEligible     Boolean  @default(false) @map("teammate_clue_eligible")

  teammatePairsAsPlayer   PlayerTeammate[] @relation("TeammatePairPlayer")
  teammatePairsAsTeammate PlayerTeammate[] @relation("TeammatePairTeammate")

  @@map("players")
}

model PlayerTeammate {
  playerId        String @map("player_id")
  teammateId      String @map("teammate_id")
  seasonsTogether Int    @default(1) @map("seasons_together")

  player   Player @relation("TeammatePairPlayer", fields: [playerId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "player_teammates_player_fkey")
  teammate Player @relation("TeammatePairTeammate", fields: [teammateId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "player_teammates_teammate_fkey")

  @@id([playerId, teammateId], map: "player_teammates_pkey")
  @@index([teammateId], map: "player_teammates_teammate_id_idx")
  @@map("player_teammates")
}

enum MatchMode {
  AI
  ONLINE

  @@map("match_mode")
}

enum MatchParticipant {
  PLAYER1
  PLAYER2

  @@map("match_participant")
}

enum MatchStatus {
  WAITING
  ACTIVE
  FINISHED
  ABANDONED

  @@map("match_status")
}

enum MatchEndReason {
  THREE_IN_ROW
  DRAW
  FORFEIT

  @@map("match_end_reason")
}

model Match {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode                MatchMode
  player1Id           String            @map("player1_id") @db.Uuid
  player2Id           String?           @map("player2_id") @db.Uuid
  grid                Json              @db.JsonB
  board               Json              @default("[null,null,null,null,null,null,null,null,null]") @db.JsonB
  history             Json              @default("[]") @db.JsonB
  status              MatchStatus       @default(WAITING)
  currentPlayer       MatchParticipant? @map("current_player")
  winner              MatchParticipant?
  endReason           MatchEndReason?   @map("end_reason")
  turnNumber          Int               @default(0) @map("turn_number")
  turnDurationSeconds Int               @map("turn_duration_seconds")
  turnEndsAt          DateTime?         @map("turn_ends_at") @db.Timestamptz(6)
  version             Int               @default(0)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  finishedAt          DateTime?         @map("finished_at") @db.Timestamptz(6)

  @@index([player1Id, createdAt])
  @@index([player2Id, createdAt])
  @@index([status, turnEndsAt])
  @@map("matches")
}
