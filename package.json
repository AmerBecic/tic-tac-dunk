{
  "name": "tic-tac-dunk",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "typecheck:seed": "tsc --project tsconfig.seed.json --noEmit",
    "prisma:generate": "prisma generate",
    "daily:generate": "tsx scripts/GenerateDailyPuzzle.ts",
    "seed": "pnpm seed:teams && pnpm seed:players && pnpm seed:teammates",
    "seed:teams": "tsx -r tsconfig-paths/register prisma/seed-teams.ts",
    "seed:players": "tsx -r tsconfig-paths/register prisma/seed.ts",
    "seed:teammates": "tsx -r tsconfig-paths/register prisma/seed-teammates.ts",
    "scss-types": "typed-scss-modules src --aliasPrefixes.@ ./src/",
    "scss-types:watch": "typed-scss-modules src --watch --aliasPrefixes.@ ./src/",
    "generate-player-data-per-season": "tsx src/core/database/scripts/generate-player-data-per-season.ts",
    "generate-raw-player-data": "tsx src/core/database/scripts/generate-raw-player-data.ts",
    "generate-final-player-data": "tsx src/core/database/scripts/generate-final-player-data.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@supabase/server": "^1.6.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "dotenv": "^17.4.2",
    "hamburger-react": "^2.5.2",
    "lucide-react": "^1.24.0",
    "next": "16.4.5",
    "next-intl": "^4.13.0",
    "pg": "^8.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-nba-logos": "^1.1.3",
    "react-use": "^17.6.0",
    "sass": "^1.89.2",
    "use-debounce": "^10.1.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown",
    "*.{ts,tsx}": "eslint --fix"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@types/node": "^20.17.51",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "prettier": "^3.5.3",
    "prisma": "^7.8.0",
    "supabase": "^2.108.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-esm-loader": "^1.0.1",
    "tsx": "^4.19.4",
    "typed-scss-modules": "^8.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0",
    "uuid": "^11.1.0"
  },
  "packageManager": "pnpm@9.12.0+sha512.4abf725084d7bcbafbd728bfc7bee61f2f791f977fd87542b3579dcb23504d170d46337945e4c66485cd12d588a0c0e570ed9c477e7ccdd8507cf05f3f92eaca"
}
